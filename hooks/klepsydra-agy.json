{
  "klepsydra": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ~/.claude/klepsydra-engine.sh agy SessionStart",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ~/.claude/klepsydra-engine.sh agy PreInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/klepsydra-engine.sh agy PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/klepsydra-engine.sh agy PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash ~/.claude/klepsydra-engine.sh agy Stop",
        "timeout": 10
      }
    ]
  }
}

#!/usr/bin/env bash
# fleet COMMAND: the klepsydra fleet's own commands.
#   fleet doctor          check the fleet's health, one line per check
#   fleet log [N]         the last N decisions (default 30), as plain lines
#   fleet brief NAME BODY write task-NAME.src: BODY plus the shared rules
#   fleet brief --check   list briefs whose shared rules are out of date
#   fleet install         link this checkout's scripts and units into place
#   fleet cutover         restart the resume service on the installed scripts
set -u
here=$(dirname "$(readlink -f "$0")")
cmd=${1:-}
shift || true
case $cmd in
  doctor) exec bash "$here/doctor.sh" "$@" ;;
  brief) exec bash "$here/brief.sh" "$@" ;;
  install) exec bash "$here/install.sh" "$@" ;;
  log)
    # shellcheck source=fleet/lib.sh
    . "$here/lib.sh"
    tail -n "${1:-30}" "$FLEET_LOG" | jq -r '[.ts[0:19], .level, .target, .message] + ([to_entries[] | select(.key | IN("ts","level","target","message","run_id") | not) | "\(.key)=\(.value)"]) | join(" ")'
    ;;
  cutover)
    # shellcheck source=fleet/lib.sh
    . "$here/lib.sh"
    FLEET_TARGET=fleet::cutover
    systemctl --user stop fleet-resume-at-reset.service 2>/dev/null
    systemctl --user reset-failed fleet-resume-at-reset.service 2>/dev/null
    systemctl --user daemon-reload
    systemctl --user start fleet-resume-at-reset.service
    sleep 3
    if systemctl --user is-active --quiet fleet-resume-at-reset.service && grep -q '"resume service started"' <(tail -n 50 "$FLEET_LOG"); then
      flog INFO "resume service restarted on the installed scripts"
      echo "fleet-resume-at-reset: active, and its start is logged"
    else
      flog ERROR "resume service did not come back after the cut-over"
      systemctl --user status fleet-resume-at-reset.service --no-pager | tail -5
      exit 1
    fi
    ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; [[ -z $cmd ]] || exit 2 ;;
esac

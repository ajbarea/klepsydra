#!/usr/bin/env bash
# fleet COMMAND: the klepsydra fleet's own commands.
#   fleet doctor [--json FILE]  check the fleet's health, one line per check (and a report)
#   fleet doctor --prune        drop finished agents' rows from panes.tsv (a backup beside it)
#   fleet log [N]         the last N decisions (default 30), as plain lines
#   fleet brief NAME BODY-FILE  write task-NAME.src: BODY-FILE's text plus the shared rules
#   fleet brief --check   list briefs whose shared rules are out of date
#   fleet brief --refresh rewrite them with the current shared rules
#   fleet accounts        each config folder: its account and its room (* where a
#                         new worker starts; workers prefer the first, Heph the last)
#   fleet accounts sync   make the second config folder behave like ~/.claude
#   fleet resume now      run one resume pass at once (the service's, when it runs) and print its decisions
#   fleet recover         after a hard shutdown, relaunch every agent whose session is gone
#   fleet send PANE TEXT  send a message to the session in PANE so it is submitted (TEXT - reads stdin)
#   fleet delegate [OPTIONS] TASK-FILE  hand read-only research, drafts, PR review or CI triage to agy or Copilot (fleet delegate --help)
#   fleet headless NAME BRIEF [--budget USD] [--model M] [--repo DIR] [--wait]  run a job as `claude -p` on the API credit, capped (docs/headless.md); --status lists jobs and costs
#   fleet done [NAME] "REPORT"  mark an agent finished (default: this pane's), so nothing relaunches it,
#                         and send the one-line REPORT to the orchestrator (- reads stdin)
#   fleet close NAME      close a finished agent's pane once its report is read
#   fleet close --why NAME  the last close of NAME: closed, or the check that refused it and what differed
#   fleet voices [MODE]   make keryx follow the tray's Voices mode (heph, everyone, off) now;
#                         --if-changed only a mode not yet applied, --check only report
#   fleet pause NAME WHY  set aside an agent whose session is gone (paused.tsv keeps its row)
#   fleet unpause NAME    put it back; the next fleet recover launches it
#   fleet shots [--apply] prune the briefing's decided and old screenshots (dry run without --apply)
#   fleet install [--dry-run] [--hooks] [--force] [--no-cutover]  link this checkout's scripts and units into place,
#                         copy the hooks, status line, launcher and cast
#   fleet cutover         move the fleet's units onto the installed unit files and start them
set -u
here=$(dirname "$(readlink -f "$0")")
cmd=${1:-}
shift || true
case $cmd in
  doctor) exec bash "$here/doctor.sh" "$@" ;;
  headless) exec bash "$here/headless.sh" "$@" ;;
  delegate) exec bash "$here/delegate.sh" "$@" ;;
  brief) exec bash "$here/brief.sh" "$@" ;;
  install) exec bash "$here/install.sh" "$@" ;;
  recover) exec bash "$here/recover.sh" "$@" ;;
  resume)
    [[ ${1:-} == now && $# == 1 ]] || { echo "usage: fleet resume now" >&2; exit 2; }
    exec bash "$here/resume-now.sh"
    ;;
  done) exec bash "$here/done.sh" "$@" ;;
  close) exec bash "$here/close.sh" "$@" ;;
  send) exec bash "$here/send.sh" "$@" ;;
  voices) exec bash "$here/voices.sh" "$@" ;;
  pause | unpause) exec bash "$here/pause.sh" "$cmd" "$@" ;;
  shots)
    # shellcheck source=fleet/lib.sh
    FLEET_BRIEFING=$(. "$here/lib.sh" && printf %s "$FLEET_BRIEFING") exec python3 -I "$here/prune_shots.py" "$@" ;;
  accounts)
    if [[ ${1:-} == sync ]]; then shift; exec bash "$here/accounts-sync.sh" "$@"; fi
    # shellcheck source=fleet/lib.sh
    . "$here/lib.sh"
    now=$(date +%s) best=$(best_account "$now")
    for dir in $FLEET_ACCOUNTS; do
      if id=$(account_of "$dir"); then
        read -r five seven <<<"$(headroom "$id" "$now")"
        printf '%s %s: %s, five-hour room %s%%, weekly room %s%%%s\n' "$([[ $dir == "$best" ]] && echo '*' || echo ' ')" "$dir" "$(account_label "$id")" "$five" "$seven" \
          "$([[ $dir == "${FLEET_ACCOUNTS%% *}" ]] && echo ' (workers prefer)')$([[ $dir == "${FLEET_HEPH_ACCOUNTS%% *}" ]] && echo ' (Heph prefers)')"
      else
        hint="claude auth login"
        [[ $dir == "$FLEET_DEFAULT_CONFIG" ]] || hint="CLAUDE_CONFIG_DIR=$dir $hint"
        printf '  %s: not logged in (%s)\n' "$dir" "$hint"
      fi
    done
    for acct_dir in "$KLEPSYDRA_DIR"/accounts/*; do
      [[ -d "$acct_dir" ]] || continue
      acct=$(basename "$acct_dir")
      skip=0
      for dir in $FLEET_ACCOUNTS; do
        if id=$(account_of "$dir") && [[ "$id" == "$acct" ]]; then skip=1; break; fi
      done
      (( skip )) && continue
      f=$(reading_of "$acct") || continue
      lbl=$(account_label "$acct")
      windows_info=$(jq -r --argjson now "$now" '
        def room(w): if w == null or (w.resets_at // 0) <= $now then 100
          else 100 - (w.used_percentage // 0) end;
        .windows | to_entries[] | "\(.key) room \((room(.value) | floor))%"
      ' "$f" 2>/dev/null | tr '\n' ', ' | sed 's/, $//')
      [[ -n $windows_info ]] && printf '  %s: %s, %s\n' "$acct" "$lbl" "$windows_info"
    done
    ;;
  log)
    # shellcheck source=fleet/lib.sh
    . "$here/lib.sh"
    tail -n "${1:-30}" "$FLEET_LOG" | jq -r '[.ts[0:19], .level, .target, .message] + ([to_entries[] | select(.key | IN("ts","level","target","message","run_id") | not) | "\(.key)=\(.value)"]) | join(" ")'
    ;;
  cutover) exec bash "$here/cutover.sh" "$@" ;;
  *) sed -n '2,/^set -u/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; [[ -z $cmd ]] || exit 2 ;;
esac

#!/usr/bin/env bash
# fleet COMMAND: the klepsydra fleet's own commands.
#   fleet doctor [--json FILE]  check the fleet's health, one line per check (and a report)
#   fleet log [N]         the last N decisions (default 30), as plain lines
#   fleet brief NAME BODY write task-NAME.src: BODY plus the shared rules
#   fleet brief --check   list briefs whose shared rules are out of date
#   fleet brief --refresh rewrite them with the current shared rules
#   fleet accounts        each config folder: its account and its room (* where a
#                         new worker starts; workers prefer the first, Heph the last)
#   fleet accounts sync   make the second config folder behave like ~/.claude
#   fleet recover         after a hard shutdown, relaunch every agent whose session is gone
#   fleet shots [--apply] prune the briefing's decided and old screenshots (dry run without --apply)
#   fleet report TEXT     tell the orchestrator, only at his idle, empty prompt (else queued for it)
#   fleet agora post [--kind K] TEXT  post one line on the Agora, as your character (optional)
#   fleet agora list [N]  the newest Agora posts
#   fleet install         link this checkout's scripts and units into place
#   fleet cutover         restart the resume service on the installed scripts
set -u
here=$(dirname "$(readlink -f "$0")")
cmd=${1:-}
shift || true
case $cmd in
  doctor) exec bash "$here/doctor.sh" "$@" ;;
  brief) exec bash "$here/brief.sh" "$@" ;;
  install) exec bash "$here/install.sh" "$@" ;;
  recover) exec bash "$here/recover.sh" "$@" ;;
  report) exec bash "$here/report.sh" "$@" ;;
  shots) exec python3 -I "$here/prune_shots.py" "$@" ;;
  agora) exec python3 -I "$here/agora.py" "$@" ;;
  accounts)
    if [[ ${1:-} == sync ]]; then shift; exec bash "$here/accounts-sync.sh" "$@"; fi
    # shellcheck source=fleet/lib.sh
    . "$here/lib.sh"
    now=$(date +%s) best=$(best_account "$now")
    for dir in $FLEET_ACCOUNTS; do
      if id=$(account_of "$dir"); then
        read -r five seven <<<"$(headroom "$id" "$now")"
        printf '%s %s: %s, five-hour room %s%%, weekly room %s%%%s\n' "$([[ $dir == "$best" ]] && echo '*' || echo ' ')" "$dir" "$(account_label "$id")" "$five" "$seven" \
          "$([[ $dir == "${FLEET_ACCOUNTS%% *}" ]] && echo ' (workers prefer)')$([[ $dir == "${FLEET_HEPH_ACCOUNTS%% *}" ]] && echo ' (Heph prefers)')"
      else
        hint="claude auth login"
        [[ $dir == "$FLEET_DEFAULT_CONFIG" ]] || hint="CLAUDE_CONFIG_DIR=$dir $hint"
        printf '  %s: not logged in (%s)\n' "$dir" "$hint"
      fi
    done
    ;;
  log)
    # shellcheck source=fleet/lib.sh
    . "$here/lib.sh"
    tail -n "${1:-30}" "$FLEET_LOG" | jq -r '[.ts[0:19], .level, .target, .message] + ([to_entries[] | select(.key | IN("ts","level","target","message","run_id") | not) | "\(.key)=\(.value)"]) | join(" ")'
    ;;
  cutover) exec bash "$here/cutover.sh" "$@" ;;
  *) sed -n '2,/^set -u/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; [[ -z $cmd ]] || exit 2 ;;
esac
